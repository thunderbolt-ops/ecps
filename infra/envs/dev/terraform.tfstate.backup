    {
      "mode": "managed",
      "type": "kubernetes_manifest",
      "name": "virtual_cost_rules",
      "provider": "provider[\"registry.terraform.io/hashicorp/kubernetes\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "computed_fields": null,
            "field_manager": [],
            "manifest": {
              "value": {
                "apiVersion": "monitoring.coreos.com/v1",
                "kind": "PrometheusRule",
                "metadata": {
                  "labels": {
                    "app": "ecps-virtual-cost",
                    "release": "kube-prometheus-stack",
                    "role": "finops"
                  },
                  "name": "ecps-virtual-cost",
                  "namespace": "platform-observability"
                },
                "spec": {
                  "groups": [
                    {
                      "interval": "1m",
                      "name": "virtual-cost",
                      "rules": [
                        {
                          "expr": "sum by (namespace) (\n  kube_pod_container_resource_requests{\n    resource=\"cpu\",\n    unit=\"core\"\n  }\n) * 10\n",
                          "record": "ecps_virtual_cpu_cost_credits_per_hour"
                        },
                        {
                          "expr": "sum by (namespace) (\n  kube_pod_container_resource_requests{\n    resource=\"memory\",\n    unit=\"byte\"\n  } / 1024 / 1024 / 1024\n) * 2\n",
                          "record": "ecps_virtual_memory_cost_credits_per_hour"
                        },
                        {
                          "expr": "ecps_virtual_cpu_cost_credits_per_hour\n+\necps_virtual_memory_cost_credits_per_hour\n",
                          "record": "ecps_virtual_total_cost_credits_per_hour"
                        },
                        {
                          "expr": "sum by (team) (\n  label_replace(\n    ecps_virtual_total_cost_credits_per_hour,\n    \"team\",\n    \"$1\",\n    \"namespace\",\n    \"team-(.*)\"\n  )\n)\n",
                          "record": "ecps_virtual_total_cost_credits_per_hour_by_team"
                        }
                      ]
                    }
                  ]
                }
              },
              "type": [
                "object",
                {
                  "apiVersion": "string",
                  "kind": "string",
                  "metadata": [
                    "object",
                    {
                      "labels": [
