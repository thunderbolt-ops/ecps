              ]
            },
            "object": {
              "value": {
                "apiVersion": "monitoring.coreos.com/v1",
                "kind": "PrometheusRule",
                "metadata": {
                  "annotations": {
                    "prometheus-operator-validated": "true"
                  },
                  "creationTimestamp": null,
                  "deletionGracePeriodSeconds": null,
                  "deletionTimestamp": null,
                  "finalizers": null,
                  "generateName": null,
                  "generation": null,
                  "labels": {
                    "app": "hello-app-slo",
                    "release": "kube-prometheus-stack",
                    "role": "slo"
                  },
                  "managedFields": null,
                  "name": "hello-app-slo",
                  "namespace": "platform-observability",
                  "ownerReferences": null,
                  "resourceVersion": null,
                  "selfLink": null,
                  "uid": null
                },
                "spec": {
                  "groups": [
                    {
                      "interval": "30s",
                      "limit": null,
                      "name": "hello-app-slo",
                      "partial_response_strategy": null,
                      "rules": [
                        {
                          "alert": null,
                          "annotations": null,
                          "expr": "kube_deployment_status_replicas_available{\n  namespace=\"team-alpha\",\n  deployment=\"hello-app\"\n}\n",
                          "for": null,
                          "keep_firing_for": null,
                          "labels": null,
                          "record": "hello_app_alpha_available_replicas"
                        },
                        {
                          "alert": null,
                          "annotations": null,
                          "expr": "kube_deployment_spec_replicas{\n  namespace=\"team-alpha\",\n  deployment=\"hello-app\"\n}\n",
                          "for": null,
                          "keep_firing_for": null,
                          "labels": null,
                          "record": "hello_app_alpha_desired_replicas"
                        },
                        {
                          "alert": null,
                          "annotations": null,
                          "expr": "clamp_min(\n  hello_app_alpha_available_replicas\n  /\n  hello_app_alpha_desired_replicas,\n  0\n)\n",
                          "for": null,
                          "keep_firing_for": null,
                          "labels": null,
                          "record": "hello_app_alpha_sli"
                        },
                        {
                          "alert": null,
                          "annotations": null,
                          "expr": "avg_over_time(hello_app_alpha_sli[5m])\n",
                          "for": null,
                          "keep_firing_for": null,
                          "labels": null,
                          "record": "hello_app_alpha_sli_5m"
                        },
                        {
                          "alert": null,
                          "annotations": null,
                          "expr": "avg_over_time(hello_app_alpha_sli[30m])\n",
                          "for": null,
                          "keep_firing_for": null,
                          "labels": null,
                          "record": "hello_app_alpha_sli_30m"
                        },
                        {
                          "alert": null,
                          "annotations": null,
                          "expr": "(1 - hello_app_alpha_sli_5m) / (1 - 0.99)\n",
                          "for": null,
                          "keep_firing_for": null,
                          "labels": null,
                          "record": "hello_app_alpha_error_budget_burn_5m"
                        },
                        {
                          "alert": null,
                          "annotations": null,
                          "expr": "(1 - hello_app_alpha_sli_30m) / (1 - 0.99)\n",
                          "for": null,
                          "keep_firing_for": null,
                          "labels": null,
                          "record": "hello_app_alpha_error_budget_burn_30m"
                        },
                        {
                          "alert": "HelloAppAlphaFastBurn",
                          "annotations": {
                            "description": "hello-app in team-alpha is burning error budget quickly.\n5m burn rate: {{ printf \"%.2f\" $value }}\nSLO target: 99.0% availability.\n",
                            "summary": "hello-app (team-alpha) fast error budget burn"
                          },
                          "expr": "(hello_app_alpha_error_budget_burn_5m \u003e 5)\nand\n(hello_app_alpha_error_budget_burn_30m \u003e 1)\n",
                          "for": "5m",
                          "keep_firing_for": null,
                          "labels": {
                            "severity": "warning",
                            "team": "team-alpha"
                          },
                          "record": null
                        },
                        {
                          "alert": "HelloAppAlphaSlowBurn",
                          "annotations": {
                            "description": "hello-app in team-alpha is violating SLO over the last 30 minutes.\nCheck deployment availability and upstream dependencies.\n",
                            "summary": "hello-app (team-alpha) sustained error budget burn"
                          },
                          "expr": "hello_app_alpha_error_budget_burn_30m \u003e 2\n",
                          "for": "30m",
                          "keep_firing_for": null,
                          "labels": {
                            "severity": "critical",
                            "team": "team-alpha"
                          },
                          "record": null
                        }
                      ]
                    }
                  ]
                }
              },
